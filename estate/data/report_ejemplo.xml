<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del Reporte -->
    <record id="action_report_propiedad_pro" model="ir.actions.report">
        <field name="name">Ficha Profesional Propiedad</field>
        <field name="model">real.estate</field>
        <field name="report_type">qweb-pdf</field>
        <!-- Asegúrate que este nombre sea: nombre_modulo.id_template -->
        <field name="report_name">estate.report_pro_template</field>
        <field name="binding_model_id" ref="model_real_estate"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Diseño del Reporte -->
    <template id="report_pro_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="p">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica';">
                        <div class="row border-bottom pb-3 mb-4">
                            <div class="col-8">
                                <h1 t-field="p.name" style="color: #2c3e50;"/>
                                <span class="badge badge-info" t-field="p.property_type_id" style="font-size: 1.2em; border: 1px solid #ccc; padding: 5px;"/>
                            </div>
                            <div class="col-4 text-right" style="text-align: right;">
                                <h2 style="color: #e67e22;">
                                    <span t-field="p.expected_price" t-options='{"widget": "monetary", "display_currency": p.company_id.currency_id}'/>
                                </h2>
                                <p class="text-muted">ID Registro: <span t-field="p.id"/></p>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-7">
                                <h4>Descripción</h4>
                                <p t-field="p.description" class="text-justify"/>
                                
                                <table class="table table-sm mt-3" style="width: 100%;">
                                    <tr>
                                        <td><strong>Habitaciones:</strong></td>
                                        <td><span t-field="p.bedrooms"/></td>
                                        <td><strong>Área Total:</strong></td>
                                        <td><span t-field="p.total_area"/> m²</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Garaje:</strong></td>
                                        <td><span t-if="p.garage">Sí</span><span t-else="">No</span></td>
                                        <td><strong>Disponible:</strong></td>
                                        <td><span t-field="p.date_availability"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-5 text-center" style="border-left: 1px solid #eee; padding-left: 20px;">
                                <!-- Usamos Google Charts: Esta URL genera el QR externamente y Odoo solo lo muestra como una imagen normal -->
                                <img t-att-src="'https://googleapis.com' + str(p.id)" style="width:150px;height:150px;"/>
                                
                                <p class="small text-muted">Escanea para ir a la Web</p>
                                
                                <div class="mt-4 p-2 bg-light" style="background-color: #f8f9fa; padding: 10px;">
                                    <strong>Comercial:</strong><br/>
                                    <span t-field="p.salesperson_id.name"/>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4" t-if="p.garden" style="background-color: #f0fff0; padding: 15px; border-radius: 5px;">
                            <div class="col-12">
                                <strong>🍃 Detalles del Jardín:</strong>
                                <p>Superficie de <span t-field="p.garden_area"/> m² con orientación <span t-field="p.garden_orientation"/>.</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
