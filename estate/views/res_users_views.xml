<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_inherit_estate" model="ir.ui.view">
        <field name="name">res.users.form.inherit.estate</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Insertamos la pestaña con un nombre distinto para no chocar con la categoría -->
            <xpath expr="//notebook" position="inside">
                <page string="Real Estate Properties" name="real_estate_properties">
                    <field name="property_ids">
                        <tree>
                            <field name="name" string="Property Name"/>
                            <field name="expected_price"/>
                            <field name="status"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
